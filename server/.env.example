# =============================================================================
# FleetLink server — local vs live is controlled by WHERE you run + these vars
# =============================================================================
# LOCAL:  copy to .env and run `npm run dev` on your machine
# LIVE:   set the same keys in Render dashboard (Environment tab), not in git
#
# Use a SEPARATE MongoDB database for live (different MONGODB_URI / db name).
# =============================================================================

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/driver_dev?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# On Render set:
# NODE_ENV=production
# MONGODB_URI=.../driver_prod?...
# JWT_*=strong random production secrets

# Firebase Cloud Messaging (from Firebase service account key)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Timezone for reminder date calculations (expense day window, maintenance overdue days)
NOTIFICATION_TIMEZONE=Asia/Karachi

# Poll reminders on a timer (minutes). Set to 10 for local testing.
# NOTIFICATION_POLL_INTERVAL_MINUTES=10

# Send expense reminders every N minutes instead of only at 22:00/23:00 local.
# Set to 10 for local testing. Use 0 in production (default).
# EXPENSE_REMINDER_INTERVAL_MINUTES=10

# Local testing only — force a slot via /health?testExpenseSlot=22|23|1230|13
# NOTIFICATION_TEST_MODE=true

# Google Sign-In (same Web client ID as mobile)
# GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Email OTP (Nodemailer) — required for real verification emails
# Without SMTP, OTP is only logged to the server console (and shown in app during dev).
#
# Gmail example (use an App Password: https://myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=FleetLink <your-email@gmail.com>
#
# On Render: set NODE_ENV=production and all SMTP_* vars above.
# Do NOT set AUTH_OTP_DEV_EXPOSE on production.
# AUTH_OTP_DEV_EXPOSE=true

# Render deploy: set Root Directory to "server" (or use /render.yaml in repo root)
# Build command: npm install && npm run build
# Start command: npm start
