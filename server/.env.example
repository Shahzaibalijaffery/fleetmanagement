# =============================================================================
# FleetLink server — local vs live is controlled by WHERE you run + these vars
# =============================================================================
# LOCAL:  copy to .env and run `npm run dev` on your machine
# LIVE:   set the same keys in Render dashboard (Environment tab), not in git
#
# Use a SEPARATE MongoDB database for live (different MONGODB_URI / db name).
# =============================================================================

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/driver_dev?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# On Render set:
# NODE_ENV=production
# MONGODB_URI=.../driver_prod?...
# JWT_*=strong random production secrets

# Firebase Cloud Messaging (from Firebase service account key)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Timezone for reminder date calculations (expense day window, maintenance overdue days)
NOTIFICATION_TIMEZONE=Asia/Karachi

# Local testing only — allows forcing expense slots via /health?testExpenseSlot=22|23
# NOTIFICATION_TEST_MODE=true

# Render deploy: set Root Directory to "server" (or use /render.yaml in repo root)
# Build command: npm install && npm run build
# Start command: npm start
