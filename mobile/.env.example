# =============================================================================
# FleetLink mobile — switch local vs live with ONE key: APP_ENV
# =============================================================================
# Copy this file to .env and edit:
#   cp .env.example .env
#
# Or run:
#   npm run env:local
#   npm run env:live
#
# After changing APP_ENV, restart Metro with cache reset:
#   npm start -- --reset-cache
# =============================================================================

# local = your machine (emulator: localhost / 10.0.2.2)
# live  = Render / production API
APP_ENV=local

# Required when APP_ENV=live — your Render web service URL + /api/v1
API_URL_LIVE=https://your-service.onrender.com/api/v1

# Optional when APP_ENV=local — for a physical phone on the same Wi‑Fi
# Example: http://192.168.1.10:3000/api/v1
API_URL_LOCAL=
